# Wi-Fi Credentials
wifi_ssid: "Your_WiFi_SSID"
wifi_password: "Your_WiFi_Password"

# Fallback AP Credentials
ap_password: "emulator_setup_pass"

# Home Assistant / ESPHome API (Generate with `openssl rand -base64 32`)
api_encryption_key: "CHANGE_ME_BASE64_32_BYTES_KEY================="

# OTA Updates
ota_password: "emulator_ota_pass"

# MQTT Broker (Optional)
mqtt_broker: "192.168.1.100"
mqtt_port: 1883
mqtt_username: ""
mqtt_password: ""

