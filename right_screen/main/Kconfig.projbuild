menu "Display Application"
    
    choice DISPLAY_SIDE
        prompt "Select the side on which the display is mounted"

        config RIGHT_SIDE_DISPLAY
            bool "Right Display Board"
            
        config LEFT_SIDE_DISPLAY
            bool "Left Display Board"
                
        
    endchoice

    config OTA_BLOCK_SIZE
        int "0-255. block transmissions to prevent buffer overrun"
        default 255
        range 0 255

    config OTA_SEPARATION_TIME_MS
        int "0-255 ms separation time between CAN frames."
        default 1
        range 0 255
endmenu